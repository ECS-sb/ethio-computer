generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SOLD
  ARCHIVED
}

/// ሽያጩ እንዴት ይጠናቀቃል፦ SELF ገዢና ሻጭ በራሳቸው (10%)፣ AGENT በድርጅቱ ኤጀንት በኩል (15%)። ክፍያውን ሻጩ ይከፍላል።
enum HandoverMode {
  SELF
  AGENT
}

enum IdDocumentType {
  FAYDA
  PASSPORT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum WalletEntryType {
  DEPOSIT
  PURCHASE
  REFUND
  SALE
  WITHDRAWAL
  WITHDRAWAL_RETURNED
  JOB_PAYMENT
  JOB_REFUND
  JOB_EARNING
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  TRANSFERRED
  CONFIRMED
  RELEASED
  DISPUTED
  CANCELLED
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  phone            String?
  suspended        Boolean  @default(false)
  verifiedSeller   Boolean  @default(false)
  /// የዋሌቱ ቀሪ ሂሳብ (ብር)። የሚቀየረው በlib/wallet.ts ብቻ ነው፤ እያንዳንዱ ለውጥ WalletEntry አለው።
  walletBalanceEtb Int      @default(0)
  /// ቻት ላይ የመገናኛ መረጃ ለመላክ የሞከረበት ብዛት (lib/chat-guard.ts)። 3 ሲደርስ በራሱ ይታገዳል።
  chatStrikes      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  listings           Listing[]
  offers             Offer[]
  purchases          Order[]             @relation("OrderBuyer")
  sales              Order[]             @relation("OrderSeller")
  buyerConversations Conversation[]      @relation("ConversationBuyer")
  messages           Message[]
  reports            Report[]
  sellerVerification SellerVerification?
  walletEntries      WalletEntry[]
  deposits           Deposit[]
  withdrawals        Withdrawal[]
  chatViolations     ChatViolation[]
  gigs               Gig[]
  gigThreads         GigThread[]         @relation("GigThreadClient")
  gigMessages        GigMessage[]
  jobsHired          Job[]               @relation("JobClient")
  jobsWorked         Job[]               @relation("JobFreelancer")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Listing {
  id               String        @id @default(cuid())
  sellerId         String
  seller           User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  platform         String
  username         String
  followers        Int
  posts            Int?
  priceEtb         Int
  category         String
  country          String
  femaleShare      Int?
  engagement       Float?
  joinedYear       Int?
  originalEmail    Boolean       @default(false)
  special          Boolean       @default(false)
  monetized        Boolean       @default(false)
  strikeFree       Boolean       @default(false)
  noAdsense        Boolean       @default(false)
  description      String        @default("")
  verificationCode String
  status           ListingStatus @default(PENDING)
  rejectReason     String?
  // AI ግምገማ (lib/listing-review.ts)፦ ስክሪንሾቶችንና መግለጫውን ያያል፤ ውሳኔው የአድሚኑ ነው።
  aiReview         Json?
  aiReviewedAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  offers        Offer[]
  orders        Order[]
  conversations Conversation[]
  reports       Report[]
  images        ListingImage[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([platform, username])
  @@map("listing")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  Int
  width     Int
  height    Int
  data      Bytes
  thumb     Bytes
  createdAt DateTime @default(now())

  @@unique([listingId, position])
  @@map("listing_image")
}

model Offer {
  id        String       @id @default(cuid())
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User         @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  amountEtb Int
  note      String       @default("")
  handover  HandoverMode @default(SELF)
  status    OfferStatus  @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order?

  @@index([listingId, status])
  @@index([buyerId])
  @@map("offer")
}

model Order {
  id         String       @id @default(cuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offerId    String       @unique
  offer      Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyerId    String
  buyer      User         @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId   String
  seller     User         @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  amountEtb  Int
  handover   HandoverMode @default(SELF)
  /// በትዕዛዙ ጊዜ የተወሰነው የድርጅቱ ክፍያ (%)፤ ሲጠናቀቅ ከሻጩ ገንዘብ ይቀነሳል።
  feePercent Int          @default(10)
  feeEtb     Int?
  payoutEtb  Int?
  /// ገዢው ከዋሌቱ የከፈለበት ጊዜ፤ ትዕዛዙ ከተሰረዘ ብሩ የሚመለሰው ይህ ካለ ብቻ ነው።
  paidAt     DateTime?
  status     OrderStatus  @default(AWAITING_PAYMENT)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  walletEntries WalletEntry[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("order")
}

model Conversation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([listingId, reporterId])
  @@index([resolved])
  @@map("report")
}

/// ሻጩ ማንነቱን ያረጋግጣል፦ ስልክ፣ ፋይዳ ወይም ፓስፖርት፣ የባንክ ሂሳብ። ስሞቹ ከተስማሙ አድሚኑ ያጸድቃል፣ ባጅ ያገኛል።
model SellerVerification {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  idType            IdDocumentType
  idNumber          String
  /// የመታወቂያው ፎቶ (WebP)፤ የሚታየው ለአድሚን ብቻ ነው።
  idImage           Bytes
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  status            ReviewStatus   @default(PENDING)
  rejectReason      String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("seller_verification")
}

/// ተጠቃሚው ወደ ድርጅቱ ሂሳብ የላከውን ብር ያሳውቃል፤ አድሚኑ ሲያረጋግጥ ዋሌቱ ላይ ይገባል።
model Deposit {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountEtb    Int
  method       String
  reference    String
  receipt      Bytes?
  status       ReviewStatus @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  walletEntries WalletEntry[]

  /// አንድ ደረሰኝ ሁለት ጊዜ እንዳይቆጠር።
  @@unique([method, reference])
  @@index([status, createdAt])
  @@index([userId])
  @@map("deposit")
}

/// ሻጩ ከዋሌቱ ወደ የተረጋገጠው የባንክ ሂሳቡ ብር ያወጣል። ብሩ ሲጠየቅ ወዲያው ይያዛል፤ ከተከለከለ ይመለሳል።
model Withdrawal {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountEtb         Int
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  status            WithdrawalStatus @default(PENDING)
  rejectReason      String?
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())

  walletEntries WalletEntry[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("withdrawal")
}

/// የዋሌቱ እያንዳንዱ እንቅስቃሴ (ገቢ +፣ ወጪ −) እና ከዚያ በኋላ የቀረው ሂሳብ።
model WalletEntry {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  type         WalletEntryType
  amountEtb    Int
  balanceAfter Int
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  depositId    String?
  deposit      Deposit?        @relation(fields: [depositId], references: [id], onDelete: Restrict)
  withdrawalId String?
  withdrawal   Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  jobId        String?
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
  @@map("wallet_entry")
}

/// ቻት ላይ የታገደ መልዕክት (ስልክ፣ ሊንክ፣ username፣ ሌላ መተግበሪያ)። ለተቀባዩ አልደረሰም።
model ChatViolation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  body           String
  reason         String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("chat_violation")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved])
  @@map("contact_message")
}

// ---- Telegram Business ክትትል
// ቦቱ ከድርጅቱ የቴሌግራም አካውንቶች ጋር በTelegram Business ይገናኛል፤ የሚመጡት መልዕክቶች እዚህ ይቀመጣሉ።

enum TelegramDirection {
  IN
  OUT
}

enum TelegramAlertType {
  PHONE_NUMBER
  TELEGRAM_CONTACT
  WHATSAPP
  BANK_ACCOUNT
  SUSPICIOUS_PHRASE
  DELETED_MESSAGE
  PAYMENT_TO_OTHER_ACCOUNT
  DUPLICATE_RECEIPT
  AI_SUSPICION
}

enum TelegramDealKind {
  SALE
  REGISTRATION
}

enum TelegramDealStatus {
  NEGOTIATING
  AGREED
  PAID
  DELIVERED
  CANCELLED
}

/// በድርጅቱ በኩል የሚሸጥ ቻናል ሁኔታ (ከሻጩም ከገዢውም ወገን)። REFUNDED፦ ብሩ ተመልሶ ሽያጩ ቀርቷል።
enum TelegramChannelStatus {
  NEGOTIATING
  AGREED
  PAID
  DELIVERED
  REFUNDED
  CANCELLED
}

enum TelegramAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

/// የድርጅቱ የቴሌግራም አካውንት ዓይነት፦ SALES (የሶሻል ሚዲያ አካውንት ሽያጭ) ወይም SCHOOL (የኢትዮ ኮምፒውተር ትምህርት ቤት / e-learning)።
enum TelegramAccountCategory {
  SALES
  SCHOOL
}

/// አንድ የድርጅት የቴሌግራም አካውንት ከቦቱ ጋር ያለው ግንኙነት። id የቴሌግራሙ business_connection_id ነው።
/// category፦ አድሚኑ በሰራተኞች ገጽ ይመርጣል፤ ሰራተኞች የተፈቀደላቸውን ምድብ ቻቶች ብቻ ያያሉ።
model TelegramConnection {
  id            String   @id
  category      TelegramAccountCategory @default(SALES)
  ownerId       BigInt
  ownerChatId   BigInt
  ownerName     String
  ownerUsername String?
  canReply      Boolean  @default(false)
  isEnabled     Boolean  @default(true)
  connectedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chats TelegramChat[]

  @@map("telegram_connection")
}

/// ከአንድ ደንበኛ ጋር ያለ ቻት። chatId የቴሌግራሙ የደንበኛ መለያ ነው።
model TelegramChat {
  id                    String             @id @default(cuid())
  connectionId          String
  connection            TelegramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chatId                BigInt
  name                  String
  username              String?
  lastMessageAt         DateTime
  lastDirection         TelegramDirection
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  /// Claude የጻፈው የቻቱ አጭር ማጠቃለያ እና የተተነተነበት ጊዜ
  aiSummary             String?
  analyzedAt            DateTime?
  /// ደንበኛው ያጋራቸው ዝርዝሮች (ስልክ፣ ኢሜይል፣ አካውንቶች፣ ለሽያጭ ያመጣቸው)፤ ቅርጹ በlib/telegram/profile.ts ውስጥ ነው።
  profile               Json?
  /// በቁልፍ ቃል ወይም በAI የተገኙ ርዕሶች፤ ለምሳሌ "withdrawal" (ከቲክቶክ ገንዘብ ማውጣት፣ የPayPal/ዶላር ምንዛሬ)
  tags                  String[]           @default([])
  /// AI ያዘጋጀው የመልስ ሀሳብ እና የሚመልሰው የሰውየው መልዕክት (አዲስ መልዕክት ሲመጣ አዲስ ሀሳብ ይዘጋጃል)
  suggestedReply        String?
  suggestedForMessageId String?
  suggestedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  messages       TelegramMessage[]
  alerts         TelegramAlert[]
  deals          TelegramDeal[]
  /// ይህ ሰው ለድርጅቱ የሸጣቸው (ሻጭ) እና ከድርጅቱ የገዛቸው (ገዢ) ቻናሎች
  channelsSold   TelegramChannel[] @relation("ChannelSeller")
  channelsBought TelegramChannel[] @relation("ChannelBuyer")

  @@unique([connectionId, chatId])
  @@index([lastMessageAt])
  @@index([lastDirection])
  @@map("telegram_chat")
}

model TelegramMessage {
  id            String            @id @default(cuid())
  chatId        String
  chat          TelegramChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId     Int
  direction     TelegramDirection
  senderName    String
  viaBot        Boolean           @default(false)
  text          String            @default("")
  mediaType     String?
  mimeType      String?
  fileId        String?
  sentAt        DateTime
  editedAt      DateTime?
  previousText  String?
  deletedAt     DateTime?
  /// ከዌብሳይቱ የተላከ ከሆነ የላከው ሰራተኛ (ከስልክ የተላከ መልዕክት ይህ የለውም፤ ቴሌግራም ዲቫይሱን አይነግርም)
  sentByUserId  String?
  sentByName    String?
  /// "ለገዢው ላክ"፦ ከሌላኛው ቻት (ለምሳሌ ከሻጩ) ተወስዶ የተላከበት መልዕክት
  relayedFromId String?
  createdAt     DateTime          @default(now())

  alerts    TelegramAlert[]
  receipt   TelegramReceipt?
  mediaFile TelegramMediaFile?

  @@unique([chatId, messageId])
  @@index([sentAt])
  @@map("telegram_message")
}

model TelegramAlert {
  id        String                @id @default(cuid())
  chatId    String
  chat      TelegramChat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId String?
  message   TelegramMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type      TelegramAlertType
  severity  TelegramAlertSeverity
  evidence  String
  resolved  Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@unique([messageId, type, evidence])
  @@index([resolved, createdAt])
  @@index([chatId])
  @@map("telegram_alert")
}

/// Claude ከቻቱ ያወጣው ሽያጭ ወይም ምዝገባ። ቻቱ በተተነተነ ቁጥር የዚያ ቻት ስምምነቶች ይተካሉ።
/// የቴሌግራም ቻቶችን የሚመልሱ ሰራተኞች፦ በGoogle የሚገቡበት ኢሜይል እና አድሚኑ የሚያበራ/የሚያጠፋቸው ፈቃዶች።
/// permissions፦ {"chats": true, "profit": false, …}፤ ያልተጠቀሰ ፈቃድ ነባሪውን ይወስዳል (lib/telegram/permissions.ts)።
model TelegramStaff {
  id          String   @id @default(cuid())
  /// ሁልጊዜ በትንሽ ፊደል
  email       String   @unique
  name        String
  active      Boolean  @default(true)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("telegram_staff")
}

/// ድርጅቱ ከሻጭ ወስዶ ለገዢ የሚሸጠው ቻናል ወይም አካውንት፦ ከማን በስንት እንደተገዛ፣ ለማን በስንት እንደተሸጠ፣ ተመላሽ ብር እና ትርፉ።
/// AI ከቻቶቹ ይሞላዋል፤ ሰራተኛ በእጅ ያስተካከላቸው መስኮች (lockedFields) በAI አይቀየሩም።
model TelegramChannel {
  id              String                 @id @default(cuid())
  platform        String
  /// የቻናሉ ሊንክ ወይም @username በአንድ ቅርጽ (ለምሳሌ "tiktok:@abebe")፤ የሻጩንና የገዢውን ቻት የሚያገናኘው ይህ ነው።
  key             String?                @unique
  link            String?
  title           String
  sellerChatId    String?
  sellerChat      TelegramChat?          @relation("ChannelSeller", fields: [sellerChatId], references: [id], onDelete: SetNull)
  /// ከሻጩ ጋር የተስማማንበት ዋጋ እና በእርግጥ የተከፈለው
  purchasePrice   Int?
  paidToSellerEtb Int?
  sourceStatus    TelegramChannelStatus?
  buyerChatId     String?
  buyerChat       TelegramChat?          @relation("ChannelBuyer", fields: [buyerChatId], references: [id], onDelete: SetNull)
  /// ከገዢው ጋር የተስማማንበት ዋጋ፣ የከፈለው እና የተመለሰለት ብር
  salePrice       Int?
  buyerPaidEtb    Int?
  refundedEtb     Int                    @default(0)
  saleStatus      TelegramChannelStatus?
  /// ገዢው የከፈለበት (ሽያጩ የተቆጠረበት) ጊዜ
  soldAt          DateTime?
  lockedFields    String[]               @default([])
  lastActivityAt  DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([sellerChatId])
  @@index([buyerChatId])
  @@index([soldAt])
  @@map("telegram_channel")
}

model TelegramDeal {
  id            String             @id @default(cuid())
  chatId        String
  chat          TelegramChat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  kind          TelegramDealKind
  item          String
  amountEtb     Int?
  status        TelegramDealStatus
  /// true፦ ወደ ድርጅቱ ሂሳብ ተከፍሏል፤ false፦ ወደ ሌላ ሂሳብ፤ null፦ አልተረጋገጠም
  paidToCompany Boolean?
  customerName  String?
  customerPhone String?
  note          String             @default("")
  /// ስምምነቱ ወይም ክፍያው የተፈጸመበት የመልዕክት ጊዜ
  dealAt        DateTime
  createdAt     DateTime           @default(now())

  @@index([chatId])
  @@index([dealAt])
  @@map("telegram_deal")
}

/// ደንበኛ የላከው ፎቶ/ፋይል የክፍያ ደረሰኝ ከሆነ Claude ያነበበው መረጃ።
model TelegramReceipt {
  id               String          @id @default(cuid())
  messageId        String          @unique
  message          TelegramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  isReceipt        Boolean
  provider         String?
  amountEtb        Float?
  recipientName    String?
  recipientAccount String?
  payerName        String?
  transactionId    String?
  paidAt           String?
  toCompany        Boolean?
  createdAt        DateTime        @default(now())

  @@index([transactionId])
  @@map("telegram_receipt")
}

/// የፎቶው የተጨመቀ ቅጂ (WebP)፤ ፎቶው በቴሌግራም ቢሰረዝም ማስረጃው እንዲቀር መልዕክቱ ሲመጣ ይቀመጣል።
model TelegramMediaFile {
  id        String          @id @default(cuid())
  messageId String          @unique
  message   TelegramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime        @default(now())

  @@map("telegram_media_file")
}

// ---- WhatsApp (የት/ቤቱ ተማሪ ምዝገባ፤ WhatsApp Cloud API)

enum WhatsAppDirection {
  IN
  OUT
}

/// OUT መልዕክት ከየት እንደተላከ፦ AUTO በሲስተሙ አውቶ ሪፕላይ፣ STAFF ከዌብሳይቱ፣ PHONE ከWhatsApp Business app (coexistence echo)።
enum WhatsAppSource {
  CUSTOMER
  AUTO
  STAFF
  PHONE
}

/// ከአንድ ሰው (ተማሪ) ጋር ያለ ቻት። waId የዋትሳፕ መለያው (ስልክ ቁጥሩ፣ ያለ +) ነው።
model WhatsAppChat {
  id             String            @id @default(cuid())
  waId           String            @unique
  name           String
  lastMessageAt  DateTime
  lastDirection  WhatsAppDirection
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// የእንኳን ደህና መጡ ምናሌው የተላከበት የመጨረሻ ጊዜ (ደጋግሞ እንዳይላክ)
  welcomedAt     DateTime?
  /// ተማሪው "ሰው ያናግረኝ" ብሏል፤ staff እስኪመልስ ድረስ አውቶ ሪፕላዩ ዝም ይላል
  needsHuman     Boolean           @default(false)
  /// ከፌስቡክ/ኢንስታግራም ማስታወቂያ (Click-to-WhatsApp) ከመጣ፦ የማስታወቂያው መለያ፣ ርዕስ እና ሙሉ referral
  adSourceId     String?
  adHeadline     String?
  referral       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  messages WhatsAppMessage[]

  @@index([lastMessageAt])
  @@index([adSourceId])
  @@map("whatsapp_chat")
}

model WhatsAppMessage {
  id           String            @id @default(cuid())
  chatId       String
  chat         WhatsAppChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// የዋትሳፕ መልዕክት መለያ (wamid…)፤ Meta አንድን webhook ደግሞ ሲልክ እንዳይደገም
  waMessageId  String            @unique
  direction    WhatsAppDirection
  source       WhatsAppSource
  /// text, image, audio, document, interactive, button, location, …
  type         String
  text         String            @default("")
  /// ተማሪው የተጫነው አዝራር ወይም የምናሌ ምርጫ መለያ
  replyId      String?
  mediaId      String?
  mimeType     String?
  /// sent, delivered, read, failed (ለOUT መልዕክቶች)
  status       String?
  errorText    String?
  sentByUserId String?
  sentByName   String?
  sentAt       DateTime
  createdAt    DateTime          @default(now())

  @@index([chatId, sentAt])
  @@map("whatsapp_message")
}

// ---- ባለሙያ ቅጠሩ (Hire talent)፦ ቮይስ ኦቨር፣ ታምብኔል፣ ኤዲቲንግ፣ AI ቪዲዮ
// ደንበኛው ሲቀጥር ብሩ ከዋሌቱ ተይዞ (escrow) ይቆያል፤ ስራውን ሲያጸድቅ ለባለሙያው ይገባል።

enum GigCategory {
  VOICE_OVER
  THUMBNAIL
  VIDEO_EDITING
  AI_VIDEO
}

/// PAUSED፦ ባለሙያው ለጊዜው አዲስ ስራ አይቀበልም።
enum GigStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

/// REQUESTED፦ ተከፍሎ ባለሙያው እንዲቀበል ይጠብቃል። DECLINED/REFUNDED፦ ብሩ ለደንበኛው ተመልሷል።
enum JobStatus {
  REQUESTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  DISPUTED
  DECLINED
  REFUNDED
}

/// ባለሙያው የሚያቀርበው አገልግሎት (ፖርትፎሊዮ ያለው)፤ አድሚኑ ካጸደቀው በኋላ በገጹ ላይ ይታያል።
model Gig {
  id             String      @id @default(cuid())
  freelancerId   String
  freelancer     User        @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  category       GigCategory
  title          String
  description    String
  /// መነሻ ዋጋ፤ ደንበኛው ከዚህ በታች መቅጠር አይችልም
  priceEtb       Int
  deliveryDays   Int
  /// YouTube ወይም Google Drive ሊንኮች (ለቪዲዮ ናሙናዎች)፤ አድሚኑ ይገመግማቸዋል
  portfolioLinks String[]    @default([])
  status         GigStatus   @default(PENDING)
  rejectReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  samples GigSample[]
  threads GigThread[]
  jobs    Job[]

  @@index([status, category])
  @@index([freelancerId])
  @@map("gig")
}

/// የፖርትፎሊዮ ናሙና፦ ምስል (WebP፣ ከthumb ጋር) ወይም ድምፅ (ለቮይስ ኦቨር)።
model GigSample {
  id        String   @id @default(cuid())
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  mimeType  String
  width     Int?
  height    Int?
  data      Bytes
  thumb     Bytes?
  createdAt DateTime @default(now())

  @@unique([gigId, position])
  @@map("gig_sample")
}

/// በአንድ አገልግሎት ላይ ደንበኛውና ባለሙያው የሚነጋገሩበት ቻት (ከመቅጠር በፊትም በኋላም)።
model GigThread {
  id        String   @id @default(cuid())
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  clientId  String
  client    User     @relation("GigThreadClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages GigMessage[]
  jobs     Job[]

  @@unique([gigId, clientId])
  @@index([clientId])
  @@map("gig_thread")
}

/// system፦ በሲስተሙ የተጻፈ (ለምሳሌ "ስራው ደርሷል")፤ ላኪው ድርጊቱን የፈጸመው ሰው ነው።
model GigMessage {
  id        String    @id @default(cuid())
  threadId  String
  thread    GigThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body      String
  system    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
  @@map("gig_message")
}

model Job {
  id            String     @id @default(cuid())
  gigId         String
  gig           Gig        @relation(fields: [gigId], references: [id], onDelete: Restrict)
  threadId      String
  thread        GigThread  @relation(fields: [threadId], references: [id], onDelete: Restrict)
  clientId      String
  client        User       @relation("JobClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancerId  String
  freelancer    User       @relation("JobFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  amountEtb     Int
  brief         String
  status        JobStatus  @default(REQUESTED)
  feePercent    Int
  feeEtb        Int?
  payoutEtb     Int?
  dueAt         DateTime?
  deliveryNote  String?
  deliveredAt   DateTime?
  revisionCount Int        @default(0)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  files         JobFile[]
  review        JobReview?
  walletEntries WalletEntry[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([threadId])
  @@map("job")
}

/// ባለሙያው ያስረከበው ፋይል (ደንበኛው፣ ባለሙያው እና አድሚኑ ብቻ ያዩታል)።
model JobFile {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([jobId])
  @@map("job_file")
}

/// ደንበኛው ስራው ከተጠናቀቀ በኋላ የሚሰጠው ደረጃ (1-5) እና አስተያየት፤ በአገልግሎቱ ገጽ ላይ ይታያል።
model JobReview {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  gigId     String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([gigId])
  @@map("job_review")
}
